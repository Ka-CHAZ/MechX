import sys
import math
from PySide6.QtCore import Qt
from PySide6.QtWidgets import QApplication, QWidget, QVBoxLayout, QHBoxLayout, QPushButton, QLineEdit, QTextBrowser, QGridLayout

class Calculator(QWidget):
    def __init__(self):
        super().__init__()

        self.setWindowTitle("Scientific Calculator")
        self.setGeometry(200, 200, 400, 600)

        self.current_expression = ""
        self.memory = []
        self.is_radian = True  # Default to radian mode

        self.init_ui()

    def init_ui(self):
        # Main layout
        main_layout = QVBoxLayout(self)

        # Live display for the current expression
        self.live_display = QLineEdit(self)
        self.live_display.setReadOnly(True)
        self.live_display.setAlignment(Qt.AlignRight)
        self.live_display.setStyleSheet("font-size: 18px; height: 40px; border: 1px solid #ccc;")
        main_layout.addWidget(self.live_display)

        # History display (QTextBrowser to support rich text, hover, and clickable)
        self.history_display = QTextBrowser(self)
        self.history_display.setReadOnly(True)
        self.history_display.setTextInteractionFlags(Qt.TextBrowserInteraction)
        self.history_display.setOpenExternalLinks(False)
        self.history_display.setStyleSheet("""
            QTextBrowser {
                font-family: monospace;
                font-size: 14px;
                background-color: #2e2e2e;
                color: white;
                padding: 10px;
                border: 1px solid #444;
            }
            .history-entry {
                padding: 5px;
                margin: 2px;
                border-radius: 5px;
            }
        """)
        self.history_display.mousePressEvent = self.handle_history_click  # Link click handler
        main_layout.addWidget(self.history_display)

        # Button layout
        button_layout = QGridLayout()

        # Define buttons for a more realistic layout
        buttons = [
            ("7", 0, 0), ("8", 0, 1), ("9", 0, 2), ("/", 0, 3),
            ("4", 1, 0), ("5", 1, 1), ("6", 1, 2), ("*", 1, 3),
            ("1", 2, 0), ("2", 2, 1), ("3", 2, 2), ("-", 2, 3),
            ("0", 3, 0), (".", 3, 1), ("=", 3, 2), ("+", 3, 3),
            ("sin", 4, 0), ("cos", 4, 1), ("tan", 4, 2), ("^", 4, 3),
            ("sqrt", 5, 0), ("pi", 5, 1), ("log", 5, 2), ("(", 5, 3),
            (")", 6, 0), ("rad", 6, 1), ("deg", 6, 2), ("clr", 6, 3)
        ]

        # Add buttons to the grid layout
        for btn_text, row, col in buttons:
            button = QPushButton(btn_text, self)
            button.clicked.connect(self.on_button_click)
            button_layout.addWidget(button, row, col)

        main_layout.addLayout(button_layout)

    def on_button_click(self):
        button = self.sender()
        button_text = button.text()

        if button_text == "=":
            self.evaluate_expression()
        elif button_text == "clr":
            self.clear_display()
        elif button_text == "rad":
            self.is_radian = True
            self.live_display.setText(self.current_expression + " rad")
        elif button_text == "deg":
            self.is_radian = False
            self.live_display.setText(self.current_expression + " deg")
        else:
            self.current_expression += button_text
            self.live_display.setText(self.current_expression)

    def evaluate_expression(self):
        try:
            # Handle radian/degree conversion
            if "rad" in self.current_expression:
                self.current_expression = self.current_expression.replace("rad", "")
                radian_mode = True
            elif "deg" in self.current_expression:
                self.current_expression = self.current_expression.replace("deg", "")
                radian_mode = False
            else:
                radian_mode = self.is_radian  # Default to radian

            # Evaluate the expression
            result = eval(self.current_expression, {"sin": self.sin, "cos": self.cos, "tan": self.tan, "sqrt": math.sqrt, "log": math.log, "pi": math.pi, "pow": math.pow})
            
            # Convert result to degrees if needed
            if not radian_mode:
                result = math.degrees(result)

            self.append_to_history(self.current_expression, result)
            self.current_expression = str(result)
            self.live_display.setText(self.current_expression)

        except Exception as e:
            self.live_display.setText("ERROR")
            self.append_to_history(self.current_expression, "ERROR")

    def sin(self, value):
        return math.sin(math.radians(value) if not self.is_radian else value)

    def cos(self, value):
        return math.cos(math.radians(value) if not self.is_radian else value)

    def tan(self, value):
        return math.tan(math.radians(value) if not self.is_radian else value)

    def clear_display(self):
        self.current_expression = ""
        self.live_display.setText(self.current_expression)

    def append_to_history(self, expression, result):
        # Add history entry with HTML formatting
        current_html = self.history_display.toHtml()
        current_html = current_html.replace('class="recent-result"', 'class="history-entry"')
        self.history_display.setHtml(current_html)

        # Add the new expression and result with proper classes
        new_entry = f"""
        <div class="history-entry">&gt; {expression}</div>
        <div class="history-entry">= {result}</div>
        <hr>
        """
        self.history_display.append(new_entry)

    def handle_history_click(self, event):
        pos = event.position().toPoint()
        cursor = self.history_display.cursorForPosition(pos)
        block = cursor.block()

        # Strip tags from line
        clicked_text = block.text().strip()

        if clicked_text.startswith(">"):
            to_insert = clicked_text[1:].strip()
        elif clicked_text.startswith("="):
            to_insert = clicked_text[1:].strip()
        else:
            return

        self.current_expression += to_insert
        self.live_display.setText(self.current_expression)

if __name__ == "__main__":
    app = QApplication(sys.argv)
    calc = Calculator()
    calc.show()
    sys.exit(app.exec())