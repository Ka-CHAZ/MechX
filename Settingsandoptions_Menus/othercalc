import sys
import math
import re
from PySide6.QtWidgets import (QLabel, QScrollArea, QFrame, QApplication, QWidget, QVBoxLayout, QHBoxLayout, QTextBrowser, QPushButton, QLabel, QTextEdit, QGridLayout, QScrollArea)
from PySide6.QtCore import Qt

class Calculator(QWidget):
    def __init__(self):
        super().__init__()
        self.setWindowTitle("TI-84 Style Calculator")

        self.current_expression = ""
        self.last_answer = 0
        self.mode = "DEG"
        self.second_mode = False

        self.trig_buttons = {}

        self.init_ui()

    def init_ui(self):
        main_layout = QVBoxLayout(self)

        self.history_display = QTextBrowser()
        self.history_display.setOpenExternalLinks(False)
        self.history_display.setReadOnly(True)
        self.history_display.setStyleSheet("font-family: monospace; font-size: 14px;")
        self.history_display.setMinimumHeight(200)
        self.history_display.setTextInteractionFlags(Qt.TextBrowserInteraction)
        main_layout.addWidget(self.history_display)

        # Enable clicking
        self.history_display.mousePressEvent = self.handle_history_click

        # Live display
        self.live_display = QLabel()
        self.live_display.setAlignment(Qt.AlignRight)
        self.live_display.setStyleSheet("font-size: 18px; padding: 8px;")
        main_layout.addWidget(self.live_display)

        # Button grid
        grid = QGridLayout()
        main_layout.addLayout(grid)

        buttons = [
            ("2nd", 0, 0), ("sin", 0, 1), ("cos", 0, 2), ("tan", 0, 3), ("log", 0, 4),
            ("7", 1, 0),  ("8", 1, 1),   ("9", 1, 2),   ("/", 1, 3),   ("sqrt", 1, 4),
            ("4", 2, 0),  ("5", 2, 1),   ("6", 2, 2),   ("*", 2, 3),   ("^", 2, 4),
            ("1", 3, 0),  ("2", 3, 1),   ("3", 3, 2),   ("-", 3, 3),   ("(", 3, 4),
            ("0", 4, 0),  (".", 4, 1),   ("Ans", 4, 2), ("+", 4, 3),   (")", 4, 4),
            ("DEG", 5, 0),("CLR", 5, 1), ("=", 5, 2, 1, 3),
        ]

        for btn_info in buttons:
            if len(btn_info) == 3:
                text, row, col = btn_info
                rowspan, colspan = 1, 1
            else:
                text, row, col, rowspan, colspan = btn_info

            btn = QPushButton(text)
            btn.setMinimumSize(60, 50)
            btn.setStyleSheet("font-size: 16px")
            btn.clicked.connect(lambda _, t=text: self.on_button_click(t))
            grid.addWidget(btn, row, col, rowspan, colspan)

            if text in ("sin", "cos", "tan"):
                self.trig_buttons[text] = btn
    
    def handle_history_click(self, event):
        pos = event.position().toPoint()
        cursor = self.history_display.cursorForPosition(pos)
        clicked_text = cursor.block().text().strip()

        # Skip divider or empty lines
        if not clicked_text or clicked_text.startswith("-"):
            return

        if clicked_text.startswith("> "):
            to_insert = clicked_text[2:].strip()  # Expression
        elif clicked_text.startswith("= "):
            to_insert = clicked_text[2:].strip()  # Result
        else:
            return  # Unknown format

        self.current_expression += to_insert
        self.live_display.setText(self.current_expression)
        
    def on_button_click(self, text):
        if text == "CLR":
            self.current_expression = ""
            self.live_display.setText("")
            return
        if text == "=":
            result = self.evaluate_expression(self.current_expression)
            self.last_answer = result if result != "Error" else self.last_answer
            self.history_display.append(f"> {self.current_expression}\n= {result}\n")
            self.current_expression = ""
            self.live_display.setText("")
            return
        if text == "Ans":
            text = str(self.last_answer)
        if text == "DEG":
            self.mode = "RAD" if self.mode == "DEG" else "DEG"
            self.history_display.append(f"Mode switched to {self.mode}")
            return
        if text == "2nd":
            self.toggle_second_mode()
            return

        # Handle second mode toggle for inverse trig
        if self.second_mode and text in ("sin", "cos", "tan"):
            text += "⁻¹"
            self.second_mode = False
            self.reset_second_mode()

        # Auto parenthesis for trig functions
        if text in ("sin", "cos", "tan", "sin⁻¹", "cos⁻¹", "tan⁻¹"):
            text += "("

        self.current_expression += text
        self.live_display.setText(self.current_expression)

    def toggle_second_mode(self):
        self.second_mode = not self.second_mode
        for name, btn in self.trig_buttons.items():
            if self.second_mode:
                btn.setText(f"{name}⁻¹")
            else:
                btn.setText(name)

    def reset_second_mode(self):
        for name, btn in self.trig_buttons.items():
            btn.setText(name)

    def evaluate_expression(self, expr):
        expr = expr.replace("^", "**")
        expr = expr.replace("sqrt", "math.sqrt")
        expr = expr.replace("log", "math.log10")

        # Auto close parentheses
        open_parens = expr.count("(")
        close_parens = expr.count(")")
        expr += ")" * (open_parens - close_parens)

        # Handle inverse trig
        expr = re.sub(r'sin⁻¹\(', 'math.asin(', expr)
        expr = re.sub(r'cos⁻¹\(', 'math.acos(', expr)
        expr = re.sub(r'tan⁻¹\(', 'math.atan(', expr)

        # Handle regular trig
        expr = re.sub(r'(?<!a)sin\(', 'math.sin(', expr)
        expr = re.sub(r'(?<!a)cos\(', 'math.cos(', expr)
        expr = re.sub(r'(?<!a)tan\(', 'math.tan(', expr)

        # Degree mode
        if self.mode == "DEG":
            expr = self.wrap_trig_with_degrees(expr)

        try:
            result = eval(expr, {"math": math})
            return round(result, 10)
        except Exception as e:
            print("Evaluation Error:", expr, e)
            return "Error"

    def wrap_trig_with_degrees(self, expr):
        # Wrap input to trig functions with radians
        expr = re.sub(r'math\.(sin|cos|tan)\(([^)]+)\)', r'math.\1(math.radians(\2))', expr)
        # Wrap output of inverse trig functions with degrees
        expr = re.sub(r'math\.a(sin|cos|tan)\(([^)]+)\)', r'math.degrees(math.a\1(\2))', expr)
        return expr

if __name__ == "__main__":
    app = QApplication(sys.argv)
    calc = Calculator()
    calc.show()
    sys.exit(app.exec())