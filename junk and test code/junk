import sys
from PySide6.QtWidgets import QApplication, QMainWindow, QGraphicsView, QGraphicsScene, QLineEdit, QVBoxLayout, QWidget
from PySide6.QtCore import Qt
from PySide6.QtGui import QBrush, QPen, QColor, QPainterPath

class MainWindow(QMainWindow):
    def __init__(self):
        super().__init__()

        self.setWindowTitle("Shape Changer")

        # Create the graphics view
        self.scene = QGraphicsScene()
        self.view = QGraphicsView(self.scene)

        # Create the line edit
        self.lineEdit = QLineEdit()
        self.lineEdit.textChanged.connect(self.updateShape)

        # Create the layout
        layout = QVBoxLayout()
        layout.addWidget(self.view)
        layout.addWidget(self.lineEdit)

        # Create the central widget
        centralWidget = QWidget()
        centralWidget.setLayout(layout)
        self.setCentralWidget(centralWidget)

        # Create the initial shape
        self.shape = self.scene.addRect(0, 0, 100, 100)
        self.shape.setBrush(QBrush(QColor("blue")))

    def updateShape(self, text):
        self.scene.removeItem(self.shape)

        if text.lower() == "circle":
            self.shape = self.scene.addEllipse(0, 0, 100, 100)
        elif text.lower() == "rectangle":
            self.shape = self.scene.addRect(0, 0, 100, 100)
        elif text.lower() == "triangle":
            path = QPainterPath()
            path.moveTo(50, 0)
            path.lineTo(100, 100)
            path.lineTo(0, 100)
            path.lineTo(50, 0)
            self.shape = self.scene.addPath(path)
        else:
            self.shape = self.scene.addRect(0, 0, 100, 100)

        self.shape.setBrush(QBrush(QColor("blue")))

if __name__ == "__main__":
    app = QApplication(sys.argv)
    window = MainWindow()
    window.show()
    sys.exit(app.exec())